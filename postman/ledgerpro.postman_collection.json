                  "pm.test(\"Account has system-generated ID and zero balance\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.be.a(\"string\");",
                  "    pm.expect(jsonData.name).to.eql(\"John Doe\");",
