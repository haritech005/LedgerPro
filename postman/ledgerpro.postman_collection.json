{
  "info": {
    "_postman_id": "a982f1b4-4b51-4091-a128-d345ef139b42",
    "name": "LedgerPro API",
    "description": "Comprehensive API collection for LedgerPro Transaction Ledger System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health and Setup",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            },
            "description": "Verifies that the application server is running and checks PostgreSQL database connectivity and latency."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has healthy status\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"healthy\");",
                  "});",
                  "",
                  "pm.test(\"Database service is connected\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.services).to.be.an(\"object\");",
                  "    pm.expect(jsonData.services.database.status).to.eql(\"connected\");",
                  "    pm.expect(jsonData.services.database.latencyMs).to.be.a(\"number\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
